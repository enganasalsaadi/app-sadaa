                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "13B07F861A680F5B00A75B9A"
                     BuildableName = "Sadaa.app"
                     BlueprintName = "Sadaa"
                     ReferencedContainer = "container:Sadaa.xcodeproj">
                  </BuildableReference>
