            <ActionContent
               title = "Run Script"
               scriptText = "# /tmp/envfile beats ENVFILE in react-native-config, so an explicit ENVFILE wins here.&#10;if [ -n &quot;$ENVFILE&quot; ]; then&#10;  echo &quot;$ENVFILE&quot; &gt; /tmp/envfile&#10;elif [ &quot;$CONFIGURATION&quot; = &quot;Release&quot; ]; then&#10;  echo &quot;.env.production&quot; &gt; /tmp/envfile&#10;else&#10;  rm -f /tmp/envfile&#10;fi&#10;">
