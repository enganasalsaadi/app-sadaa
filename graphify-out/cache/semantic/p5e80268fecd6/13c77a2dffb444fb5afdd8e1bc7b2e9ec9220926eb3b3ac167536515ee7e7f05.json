{"nodes": [{"id": "project_define_platform", "label": "Sada All-in-One Creator Marketplace", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Market is fragmented; creators and brands juggle email, WhatsApp, analytics and payment apps for one deal \u2014 consolidating into one platform is the core value."}, {"id": "project_define_dynamic_profiles", "label": "Dynamic Profiles", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces traditional portfolio by linking social accounts to surface real engagement stats and audience segmentation automatically."}, {"id": "project_define_ai_bio", "label": "AI-Generated Creator Bio/Portfolio", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bio generated from the creator profile via an AI agent."}, {"id": "project_define_matchmaking", "label": "Smart Matchmaking", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "System recommends best-fit creators from campaign details, or lets creators apply to open campaigns like freelance platforms."}, {"id": "project_define_campaign_brief_builder", "label": "Campaign Brief Builder", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guides merchants who may not know how to request an ad to specify content type, mandatory keywords, and forbidden mentions."}, {"id": "project_define_hyper_local_filter", "label": "Hyper-Local Filtering", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Search creators by governorate/city \u2014 essential for physical restaurants and shops."}, {"id": "project_define_profile_comparison", "label": "Profile Comparison Matrix", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets a client compare up to 3 creators' numbers, prices and engagement on one chart before hiring."}, {"id": "project_define_pipeline", "label": "Deal Pipeline / State Machine", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turns the ad-hoc agreement into ordered programmatic states to prevent overlap or tampering."}, {"id": "project_define_content_review", "label": "Content Review System (Drafts)", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Creator uploads video/image as a draft in-app instead of sending via WhatsApp (which reduces quality), so brand can review and approve before publishing."}, {"id": "project_define_proof_of_publish", "label": "Proof-of-Publish Link Verification", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Creator submits post/story link as proof; system verifies it, then releases escrow funds."}, {"id": "project_define_escrow", "label": "Escrow System", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trust and money is the biggest pain point; brand pays platform upfront, funds held until creator publishes and system confirms, then released."}, {"id": "project_define_wallet", "label": "Digital Wallet", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both parties need a wallet; brands deposit and pay, creators withdraw only."}, {"id": "project_define_instant_cashout", "label": "Instant Cash-out", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Creator withdraws earnings instantly to Sham Cash for a small fee instead of waiting for the usual weekly transfer."}, {"id": "project_define_contracts", "label": "Automated Contracts", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On approval, platform generates a simplified legal PDF contract (publish date, story duration, refund terms) to prevent disputes and protect both parties."}, {"id": "project_define_invoices", "label": "Automated Invoices", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "project_define_refund_pipeline", "label": "Refund Pipeline", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If creator breaches or delays publishing, funds auto-return to the merchant wallet without argument."}, {"id": "project_define_analytics_roi", "label": "Analytics & ROI Dashboard", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Brands want to know what the ad achieved; platform pulls reach/engagement/clicks post-publish into a professional report."}, {"id": "project_define_affiliate_tracking", "label": "Affiliate Links & Discount Codes", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auto-generate custom affiliate links or discount codes per creator to track actual sales."}, {"id": "project_define_qr_visit_tracking", "label": "Visit-Based QR Tracking", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generate a creator-specific QR that customers scan for a discount so the merchant knows how many visits the creator drove."}, {"id": "project_define_barter", "label": "Barter Marketplace", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Small businesses offer free products/services for an ad, documented by an in-app contract to guarantee the creator publishes."}, {"id": "project_define_barter_catalog", "label": "Barter Digital Catalog", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Companies upload products/services available for exchange so creators pick what suits them for content."}, {"id": "project_define_ugc_marketplace", "label": "UGC Marketplace", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hire creators to shoot videos/products without publishing on the creator's account, for the brand to use as its own paid ads."}, {"id": "project_define_ad_types", "label": "Ad Types", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ad types must differ: paid post/story/reel, barter, affiliate commission, visit-based QR, UGC."}, {"id": "project_define_offline_event_booking", "label": "Offline Event Booking", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Companies book a creator by the hour to attend a store opening, ribbon-cutting, or live on-ground event coverage with an hourly rate."}, {"id": "project_define_mutual_rating", "label": "Multi-Tier Mutual Rating", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rate not just by stars but on 4 criteria (timeliness, shooting quality, communication flexibility, actual results); both sides rate each other to raise market quality."}, {"id": "project_define_anonymous_brand_reviews", "label": "Anonymous Brand Reviews", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Creators anonymously write experiences with companies to warn fellow creators."}, {"id": "project_define_gamification", "label": "Gamification & Status Badges", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Public badges and ranking (fastest responder, 0% delay, top 10 in a sector) raise a creator's ranking and visibility to big brands."}, {"id": "project_define_smart_rate_calculator", "label": "Smart Rate Calculator", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Future tool suggesting a fair price based on real views and market demand so creators don't undersell."}, {"id": "project_define_local_rate_index", "label": "Local Rate Index", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shows creators the prevailing market average for similar creator tiers (without revealing identities) so they don't underprice."}, {"id": "project_define_rate_cards", "label": "Saved Rate Cards", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Save preset price packages (e.g. 3 stories bundle, reel+story) to send clients with one tap."}, {"id": "project_define_vacation_mode", "label": "Vacation Mode", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Temporarily stop receiving offers and notify companies of absence without hurting ranking or rating."}, {"id": "project_define_collab_network", "label": "Collab Network / Group Collaboration", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Future feature letting two creators merge and submit a joint package for one campaign to increase acceptance."}, {"id": "project_define_brand_clubs", "label": "Exclusive Brand Clubs", "file_type": "concept", "source_file": "project-define.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Creator joins a 