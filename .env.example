APP_ENV=development
API_BASE_URL=http://127.0.0.1:8001/api
API_VERSION=v1

SENTRY_DSN=your_sentry_dsn
ANALYTICS_KEY=your_analytics_key

ENABLE_LOGS=true
ENABLE_MOCK_DATA=false

# App Store numeric id (force-update link). Empty until published.
IOS_APP_STORE_ID=

# Public media kit host (https://<host>/c/{slug}), no scheme, e.g. links.example.com.
# Must match the Xcode build setting PUBLIC_WEB_HOST (Associated Domains).
# Empty = universal/app links off; sada://c/{slug} still works.
PUBLIC_WEB_HOST=
